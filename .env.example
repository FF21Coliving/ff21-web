# Copy to .env.local for development. Set the same keys in Vercel for previews and production.

# Site
NEXT_PUBLIC_SITE_URL=https://www.ff21.in
# Only "production" lets search engines index the site and publishes the sitemap in robots.txt.
SITE_ENV=preview

# Leads
# test = validate and log only (default). zoho = post to Zoho CRM Web-to-Lead.
LEADS_MODE=test
# Tokens from a Zoho Web-to-Lead form made for this site WITHOUT reCAPTCHA.
# (The ff21.co.in form has reCAPTCHA on, so its tokens will be rejected from here.)
ZOHO_XNQSJSDP=
ZOHO_XMIWTLD=
ZOHO_ACTION_TYPE=TGVhZHM=
ZOHO_RETURN_URL=https://www.ff21.in/find-my-home
# Text field on the new Zoho form that receives move-in, budget, room and workplace (e.g. Description).
ZOHO_DESCRIPTION_FIELD=
ZOHO_WEBTOLEAD_URL=https://crm.zoho.in/crm/WebToLeadForm
# Optional second copy of each lead (e.g. a Google Sheets webhook).
LEAD_BACKUP_WEBHOOK_URL=

# Tracking: off | gtm | direct. Use one, never both GTM and direct tags.
NEXT_PUBLIC_TAG_MODE=off
# IDs found on the current ff21.in (15 Oct 2026)
NEXT_PUBLIC_GTM_ID=GTM-W2P98LL
NEXT_PUBLIC_GA4_ID=G-7GH9DH78PF
NEXT_PUBLIC_GADS_ID=AW-773990998
# Conversion label for "lead" in Google Ads (Tools > Conversions). Not on the old site.
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=1100403134561161

# Google Search Console HTML-tag verification code
NEXT_PUBLIC_GSC_VERIFICATION=

# Supabase: every Find my home answer is saved as the visitor goes (server-side only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Zoho CRM API (LEADS_MODE=zoho-api). A Self Client from api-console.zoho.in with
# ONLY ZohoCRM.modules.leads.CREATE and ZohoCRM.modules.leads.UPDATE. Secret: Vercel only.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Any long random string; signs the lead references handed to the browser.
ZOHO_REF_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
